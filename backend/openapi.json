  "paths": {
    "/api/front-page": {
      "get": {
        "tags": [
          "front page"
        ],
        "summary": "Get Front Page",
        "operationId": "get_front_page_api_front_page_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Date `YYYY-MM-DD`, from 1900-01-01 to yesterday (São Paulo time).",
              "examples": [
                "1969-07-20"
              ],
              "title": "Date"
            },
            "description": "Date `YYYY-MM-DD`, from 1900-01-01 to yesterday (São Paulo time)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrontPage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid date or request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "External source unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too many new pages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
