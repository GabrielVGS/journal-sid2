  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Friendly pt-BR message, ready to show to the user."
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "wikipedia",
                  "nasa",
                  "worldbank",
                  "alphavantage",
                  "ipeadata",
                  "llm",
                  "openmeteo"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ApiError"
      },
      "Birth": {
        "properties": {
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "pt-BR, e.g. 'Ayrton Senna, piloto brasileiro.'"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "mentions_brazil": {
            "type": "boolean",
            "title": "Mentions Brazil",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "year",
          "text"
        ],
        "title": "Birth"
      },
      "City": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug",
            "description": "Identifier used in `?city=`: a preset ('rio-grande') or 'geo-<id>' for a city found with /api/cities/search."
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "title": "State",
            "description": "State/region, e.g. 'RS' or 'Rio Grande do Sul'."
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country",
            "description": "Country name in pt-BR (searched cities)."
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "state"
        ],
        "title": "City"
      },
      "Currency": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "pt-BR name, e.g. 'Cruzeiro Novo'."
          },
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "description": "E.g. 'NCr$'."
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "name",
          "symbol",
          "start"
        ],
        "title": "Currency"
      },
      "Editorial": {
        "properties": {
          "headlines": {
            "items": {
              "$ref": "#/components/schemas/Headline"
            },
            "type": "array",
            "title": "Headlines"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Editorial title (pt-BR)."
          },
          "body": {
            "type": "string",
            "title": "Body",
            "description": "Editorial in pt-BR, 2 to 4 paragraphs separated by a blank line."
          },
          "ai_generated": {
            "type": "boolean",
            "title": "Ai Generated",
            "description": "False when the LLM failed and headlines were built from the raw event text."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Model that wrote it (e.g. anthropic/claude-haiku-5.5)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "headlines",
          "title",
          "body",
          "ai_generated"
        ],
        "title": "Editorial"
      },
      "EditorialRequest": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "date"
        ],
        "title": "EditorialRequest"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Short id, stable within a front page (e.g. 'e3'); the LLM cites it."
          },
          "layer": {
            "type": "string",
            "enum": [
              "day",
              "month",
              "on_this_day"
            ],
            "title": "Layer"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date",
            "description": "Exact date, when known."
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Related Wikipedia article."
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "mentions_brazil": {
            "type": "boolean",
            "title": "Mentions Brazil",
            "default": false
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Ranking weight (layer + bonuses).",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "layer",
          "text"
        ],
        "title": "Event"
      },
      "Exchange": {
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "usd_then": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd Then",
            "description": "Value of US$ 1 at the time."
          },
          "usd_then_period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd Then Period",
            "description": "Rate period: 'YYYY-MM' or 'YYYY'."
          },
          "usd_then_source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alphavantage",
                  "worldbank"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd Then Source"
          },
          "usd_now": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd Now",
            "description": "US$ 1 in reais, latest month (Alpha Vantage)."
          },
          "usd_now_period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usd Now Period"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
